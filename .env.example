# Copy to .env locally. Never commit provider or registry credentials.
OPENCLAW_MODEL=
HARBOR_AGENT_BASE_IMAGE_REFERENCE=
HARBOR_AGENT_BASE_IMAGE_DIGEST=
RESOURCE_PROFILE=
RESOURCE_PROFILE_FILE=configs/resources/local.yaml
# Alternatively bind the tool prefix with scripts/provision_chemistry.py.
VGB_PYTHON=.vgb-runtime/bin/python
VGB_CHEMISTRY_PREFIX=
VGB_CHEMISTRY_LOCK=runtime-lock.json
